# EditorConfig — formatting conventions shared by editors, IDEs and AI coding agents.
# https://editorconfig.org
# Formatting only: no analyzer severities or code-style rules that affect the build.

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc,yml,yaml,md}]
indent_size = 2

[*.cs]
indent_size = 4

[*.{csproj,props,targets,sln,config}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false
