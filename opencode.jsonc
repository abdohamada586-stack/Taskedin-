{
  "$schema": "https://opencode.ai/config.json",

  // Project instructions: the root AGENTS.md is discovered and loaded automatically,
  // so it is deliberately not repeated in an "instructions" array here.

  // Ordered rules; the last matching rule wins. Unmatched operations default to "ask".
  "permissions": [
    // Ask before running shell commands, with a narrow allowlist for routine,
    // read-only or build-only work.
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet --info", "effect": "allow" },
    { "action": "shell", "resource": "dotnet --version", "effect": "allow" },
    { "action": "shell", "resource": "dotnet --list-sdks", "effect": "allow" },
    { "action": "shell", "resource": "dotnet build *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet restore *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet sln *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet list *", "effect": "allow" },

    // Never push; never destroy the working tree.
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },

    // Commits and database commands always require explicit user approval
    // (see AGENTS.md hard rules).
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "dotnet ef *", "effect": "ask" },
    { "action": "shell", "resource": "dotnet-ef *", "effect": "ask" },

    // Ask before editing generated migrations or configuration that carries
    // connection strings / auth settings.
    { "action": "edit", "resource": "**/Migrations/**", "effect": "ask" },
    { "action": "edit", "resource": "**/appsettings*.json", "effect": "ask" },

    // Ask before reading or writing outside the repository.
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],

  // Keep editor churn out of bin/obj and Visual Studio's local state.
  "watcher": {
    "ignore": ["**/bin/**", "**/obj/**", ".vs/**", "**/*.user"]
  },

  // Optional integrations. Servers stay disabled until they are intentionally
  // enabled and signed in, so nothing connects to an external service by default.
  "mcp": {
    "servers": {
      // Context7 (documented OpenCode example): current library documentation for
      // ASP.NET Core / EF Core lookups. Prerequisites to enable:
      //   1. Set "disabled" to false below.
      //   2. Run /mcps in OpenCode and sign in (OAuth), or set "oauth": false and
      //      supply a header credential via an environment variable, e.g.
      //      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" }
      //   3. Never commit an API key; keep it in an environment variable.
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": true
      }
    }
  }
}
